rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Diseases/{diseaseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /Logs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Collection ID has a space — match by name (no backticks needed)
    match /{collection}/{docId} {
      allow read: if collection == 'Soil Condition';
      allow write: if collection == 'Soil Condition' && request.auth != null;
    }
  }
}
